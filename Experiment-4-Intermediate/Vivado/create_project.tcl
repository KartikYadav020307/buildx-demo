# Run in the Vivado 2025.1.1 GUI Tcl Console:
# source C:/FPGA/Project4_NN/Vivado/create_project.tcl
# Never overwrites an existing Vivado project directory.
set nn_root [file normalize [file join [file dirname [info script]] ..]]
set nn_build [file join $nn_root build]
if {[file exists [file join $nn_build NN_Inference.xpr]]} {
    error "Project already exists. Open $nn_build/NN_Inference.xpr instead of re-running create_project.tcl."
}
create_project NN_Inference $nn_build -part xc7z020clg400-1
set_property target_language Verilog [current_project]
set_property simulator_language Mixed [current_project]
set nn_rtl [file join $nn_root RTL]
set nn_tb [file join $nn_root Testbench]
add_files [list [file join $nn_rtl nn_parallel.sv] [file join $nn_rtl nn_serial.sv] \
    [file join $nn_rtl nn_demo_controller.sv] [file join $nn_rtl nn_board_top.sv] \
    [file join $nn_rtl nn_weights.vh] [file join $nn_rtl nn_math.vh]]
set_property include_dirs [list $nn_rtl] [get_filesets sources_1]
set_property top nn_board_top [get_filesets sources_1]
add_files -fileset constrs_1 [file join $nn_rtl pynq_z2.xdc]
add_files -fileset sim_1 [list [file join $nn_tb tb_nn.sv] [file join $nn_tb vector_count.vh] \
    [file join $nn_root Data golden_vectors.mem]]
set_property include_dirs [list $nn_rtl $nn_tb] [get_filesets sim_1]
set_property top tb_nn [get_filesets sim_1]
# Absolute path avoids differences in XSim working directories on Windows.
set nn_mem [string map {\\ /} [file join $nn_root Data golden_vectors.mem]]
set_property generic [list "GOLDEN_FILE=\"$nn_mem\""] [get_filesets sim_1]
set_property xsim.simulate.runtime 4ms [get_filesets sim_1]
create_ip -name clk_wiz -vendor xilinx.com -library ip -version 6.0 -module_name nn_clk
set_property -dict [list CONFIG.PRIM_IN_FREQ {125.000} \
    CONFIG.CLKOUT1_REQUESTED_OUT_FREQ {50.000} \
    CONFIG.PRIM_SOURCE {Single_ended_clock_capable_pin} \
    CONFIG.USE_RESET {true} CONFIG.RESET_TYPE {ACTIVE_HIGH} CONFIG.USE_LOCKED {true}] [get_ips nn_clk]
create_ip -name vio -vendor xilinx.com -library ip -version 3.0 -module_name nn_vio
set_property -dict [list CONFIG.C_NUM_PROBE_IN {11} CONFIG.C_NUM_PROBE_OUT {3} \
    CONFIG.C_PROBE_IN0_WIDTH {1} CONFIG.C_PROBE_IN1_WIDTH {1} CONFIG.C_PROBE_IN2_WIDTH {1} \
    CONFIG.C_PROBE_IN3_WIDTH {2} CONFIG.C_PROBE_IN4_WIDTH {2} \
    CONFIG.C_PROBE_IN5_WIDTH {8} CONFIG.C_PROBE_IN6_WIDTH {8} \
    CONFIG.C_PROBE_IN7_WIDTH {32} CONFIG.C_PROBE_IN8_WIDTH {32} CONFIG.C_PROBE_IN9_WIDTH {32} \
    CONFIG.C_PROBE_IN10_WIDTH {32} \
    CONFIG.C_PROBE_OUT0_WIDTH {1} CONFIG.C_PROBE_OUT1_WIDTH {1} CONFIG.C_PROBE_OUT2_WIDTH {32} \
    CONFIG.C_PROBE_OUT0_INIT_VAL {0x1} CONFIG.C_PROBE_OUT1_INIT_VAL {0x0} \
    CONFIG.C_PROBE_OUT2_INIT_VAL {0x00000000}] [get_ips nn_vio]
generate_target all [get_ips {nn_clk nn_vio}]
update_compile_order -fileset sources_1
update_compile_order -fileset sim_1
puts "Project created: $nn_build/NN_Inference.xpr"
puts "Next: Run Behavioral Simulation. Expected final line: ALL TESTS PASSED."
puts "No bitstream has been generated by this script."
